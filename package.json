{
  "name": "smartcat-translate",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --configLoader runner",
    "icons:generate": "tauri icon src-tauri/icons/icon.svg",
    "records:add": "node scripts/record-change.mjs",
    "records:check": "node scripts/check-records.mjs",
    "records:test": "node --test scripts/check-records.test.mjs scripts/record-change.test.mjs scripts/omx-cli-contract.test.mjs",
    "privacy:check": "node scripts/scan-sensitive-logs.mjs scripts/fixtures/captured-logs PROJECT_LOG.txt DECISIONS.txt CHANGELOG.md RECORDING_POLICY.txt",
    "runtime:pin": "node scripts/pin-codex-runtime.mjs",
    "runtime:pin:test": "node --test scripts/pin-codex-runtime.test.mjs",
    "runtime:build": "node scripts/build-smartcat-codex-runtime.mjs",
    "runtime:build:test": "node --test scripts/build-smartcat-codex-runtime.test.mjs scripts/release-evidence.test.mjs",
    "release:evidence": "node scripts/release-evidence.mjs create-artifacts",
    "release:sbom:cargo": "node scripts/release-evidence.mjs generate-cargo",
    "release:sbom:verify": "node scripts/release-evidence.mjs verify",
    "release:configure-updater": "node scripts/configure-updater.mjs",
    "release:assets:verify": "node scripts/verify-runtime-assets.mjs",
    "release:sbom": "node scripts/generate-sbom.mjs",
    "release:licenses": "node scripts/bundle-licenses.mjs",
    "release:workflow:check": "node scripts/workflow-policy.mjs",
    "release:ref:verify": "node scripts/verify-release-ref.mjs",
    "release:keypair:verify": "node scripts/verify-updater-keypair.mjs",
    "release:package:windows": "pwsh -NoProfile -File tests/release/package-unsigned.ps1",
    "release:accept:windows": "pwsh -NoProfile -File tests/release/acceptance.ps1",
    "release:package:macos": "bash tests/release/package-unsigned.sh",
    "release:accept:macos": "bash tests/release/acceptance.sh",
    "test": "vitest run --configLoader runner",
    "test:e2e": "playwright test tests/e2e/text-translation.spec.ts",
    "test:watch": "vitest",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@cyclonedx/cyclonedx-library": "10.2.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "ajv-formats-draft2019": "1.6.1",
    "jsdom": "^26.0.0",
    "spdx-expression-parse": "5.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "yaml": "2.8.1"
  },
  "packageManager": "pnpm@10.17.1"
}
